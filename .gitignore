# Local agent registries and generated indexes
.atl/
.codegraph/

# Local machine metadata
.DS_Store

# Runtime hooks generated by Impeccable; they contain machine-specific paths.
.claude/settings.local.json
.codex/hooks.json

# Impeccable project assets are generated by the pinned installer per project.
# Keep the reusable base free of the generated bundle; do not hide unrelated
# Claude or GitHub project files.
.claude/skills/impeccable/
.github/agents/impeccable-*.agent.md
.github/hooks/impeccable.json
.github/skills/impeccable/

# Gentle-AI workspace adapters are managed/generated assets. Recreate them with
# `gentle-ai install --scope=workspace` instead of committing machine state.
.config/opencode/
.pi/

# Conversation handoff retained locally, not part of the reusable base
AI-ENGINEERING-BASE-HANDOFF.md

node_modules/
dist/
test/fixtures/project-*/
